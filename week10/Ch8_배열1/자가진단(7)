#include <stdio.h>

int main() {
    int arr[10];
    int evenSum = 0, oddSum = 0;
    for (int i = 0; i < 10; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i = 0; i < 10; i++) {
        if (i % 2 == 1) evenSum += arr[i];
        else oddSum += arr[i];
    }
    printf("sum : %d\n", evenSum);
    printf("avg : %.1f\n", oddSum / 5.0);
    return 0;
}
