int main() {
    int arr[100];
    int cnt = 0;
    while (cnt < 100) {
        scanf("%d", &arr[cnt]);
        if (arr[cnt] == 0) break;
        cnt++;
    }
    for (int i = cnt - 1; i >= 0; i--) {
        printf("%d ", arr[i]);
    }
    return 0;
}

