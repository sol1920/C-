#include <stdio.h>

int main() {
    int arr[100];
    int n = 0, cnt = 0, sum = 0;
    while (n < 100) {
        scanf("%d", &arr[n]);
        if (arr[n] == 0) break;
        n++;
    }
    for (int i = 0; i < n; i++) {
        if (arr[i] % 5 == 0) {
            cnt++;
            sum += arr[i];
        }
    }
    printf("Multiples of 5 : %d\n", cnt);
    printf("sum : %d\n", sum);
    printf("avg : %.1f\n", (double)sum / cnt);
    return 0;
}

