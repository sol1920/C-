6.#include <stdio.h>

int main() {
    int a[4][4] = {0};
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            scanf("%d", &a[i][j]);
            a[i][3] += a[i][j];
            a[3][j] += a[i][j];
            a[3][3] += a[i][j];
        }
    }
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }
    return 0;
}
7.#include <stdio.h>

int main() {
    int a[5][6] = {0};
    a[0][1] = 1;
    for (int i = 1; i < 5; i++) {
        for (int j = 1; j <= i + 1; j++) {
            a[i][j] = a[i - 1][j] + a[i - 1][j - 1];
        }
    }
    for (int i = 0; i < 5; i++) {
        for (int j = 1; j <= i + 1; j++) {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }
    return 0;
}
