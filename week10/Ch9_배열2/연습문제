2.#include <stdio.h>

int main() {
    int cnt[10] = {0};
    int x;
    while (1) {
        scanf("%d", &x);
        if (x == 0) break;
        cnt[x % 10]++;
    }
    for (int i = 0; i < 10; i++) {
        if (cnt[i] > 0) printf("%d : %d\n", i, cnt[i]);
    }
    return 0;
}
