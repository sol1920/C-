int main() {
    int a[4][2];
    int col[2] = {0}, total = 0;
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 2; j++) {
            scanf("%d", &a[i][j]);
            col[j] += a[i][j];
            total += a[i][j];
        }
    }
    for (int i = 0; i < 4; i++) {
        printf("%d ", (a[i][0] + a[i][1]) / 2);
    }
    printf("\n");
    for (int j = 0; j < 2; j++) {
        printf("%d ", col[j] / 4);
    }
    printf("\n");
    printf("%d\n", total / 8);
    return 0;
}
