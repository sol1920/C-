#include <stdio.h>

int main() {
    int cnt[11] = {0};
    int x;
    while (1) {
        scanf("%d", &x);
        if (x == 0) break;
        cnt[x / 10]++;
    }
    for (int i = 10; i >= 0; i--) {
        if (cnt[i] > 0) printf("%d : %d\n", i * 10, cnt[i]);
    }
    return 0;
}
