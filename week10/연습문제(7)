#include <stdio.h>

int main() {
    char ch[26];
    for (int i = 0; i < 26; i++) {
        ch[i] = 'A' + i;
    }
    for (int i = 25; i >= 0; i--) {
        printf("%c ", ch[i]);
    }
    return 0;
}

(연습문제3)
#include <stdio.h>

int main() {
    int arr[100];
    int cnt = 0;
    while (cnt < 100) {
        scanf("%d", &arr[cnt]);
        if (arr[cnt] == 0) break;
        cnt++;
    }
    for (int i = 1; i < cnt; i += 2) {
        printf("%d ", arr[i]);
    }
    return 0;
}

