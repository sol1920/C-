#include <stdio.h>

struct Person {
    char name[101];
    int height;
    double weight;
};

int main(void) {
    struct Person p[5], tmp;
    int i, j;

    for (i = 0; i < 5; i++) {
        scanf("%s %d %lf", p[i].name, &p[i].height, &p[i].weight);
    }

    for (i = 0; i < 4; i++) {
        for (j = 0; j < 4 - i; j++) {
            if (p[j].height > p[j + 1].height) {
                tmp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = tmp;
            }
        }
    }

    for (i = 0; i < 5; i++) {
        printf("%s %d %.1f\n", p[i].name, p[i].height, p[i].weight);
    }

    return 0;
}


#include <stdio.h>
#include <string.h>

struct Person {
    char name[101];
    int height;
    double weight;
};

int main(void) {
    struct Person p[5], tmp;
    int i, j;

    for (i = 0; i < 5; i++) {
        scanf("%s %d %lf", p[i].name, &p[i].height, &p[i].weight);
    }

    for (i = 0; i < 4; i++) {
        for (j = 0; j < 4 - i; j++) {
            if (strcmp(p[j].name, p[j + 1].name) > 0) {
                tmp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = tmp;
            }
        }
    }

    for (i = 0; i < 5; i++) {
        printf("%s %d %.1f\n", p[i].name, p[i].height, p[i].weight);
    }

    return 0;
}


#include <stdio.h>

struct Point {
    double x;
    double y;
};

int main(void) {
    struct Point a, b, c;

    scanf("%lf %lf", &a.x, &a.y);
    scanf("%lf %lf", &b.x, &b.y);

    c.x = (a.x + b.x) / 2;
    c.y = (a.y + b.y) / 2;

    printf("Center point = (%.1f, %.1f)\n", c.x, c.y);

    return 0;
}


