#include <stdio.h>

int main(void)
{
    int n, max = 0, min = 101;

    while (1) {
        scanf("%d", &n);
        if (n == 0) break;
        if (n < 1 || n > 100) continue;   // 범위 밖은 무시

        if (n > max) max = n;
        if (n < min) min = n;
    }
    printf("MAX = %d\n", max);
    printf("MIN = %d\n", min);
    return 0;
}
