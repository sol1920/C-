#include <stdio.h>

int main() {
    int n, num = 0;
    char ch = 'A';
    scanf("%d", &n);
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            if (j <= n - i + 1) {
                printf("%c ", ch);
                ch++;
            } else {
                printf("%d ", num);
                num++;
            }
        }
        printf("\n");
    }
    return 0;
}

